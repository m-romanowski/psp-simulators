  "idempotent-replay": {
    "evidence": "published rule",
    "note": "a completed request is answered with the same outcome as the original, and the answer carries the timestamp header",
    "source": "https://docs.direct.worldline-solutions.com/en/integration/api-developer-guide/idempotent-requests",
    "reference": "worldline.md, Idempotency",
    "rules": {
      "sameOutcomeAsTheOriginal": "true",
      "replayHeader": "X-GCS-Idempotence-Request-Timestamp"
    }
  }
