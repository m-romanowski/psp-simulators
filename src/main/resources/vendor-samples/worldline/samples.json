  "access-to-merchant-not-allowed": {
    "evidence": "published rule",
    "note": "a credential or account mismatch is 403 with errors.id ACCESS_TO_MERCHANT_NOT_ALLOWED, and no errorCode is published for it",
    "source": "https://docs.direct.worldline-solutions.com/en/integration/api-developer-guide/api-troubleshooting",
    "reference": "worldline.md, Authentication and Transport",
    "rules": {
      "httpStatus": "403",
      "errors.id": "ACCESS_TO_MERCHANT_NOT_ALLOWED"
    }
  },
